{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAJestic",
  "version": "0.1.12",
  "identifier": "io.github.majestic-updater",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MAJestic",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Belenos Toutatis",
    "copyright": "Copyright (c) 2026 Belenos Toutatis. MIT License.",
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"]
  }
}
